{
  "name": "@nuthinking/site-edit",
  "version": "0.1.0",
  "description": "Edit a website from the website. Pins and notes on the page become a GitHub issue; an AI agent makes the change on a branch; a preview and an email with Ship follow.",
  "keywords": [
    "site-edit",
    "website",
    "editing",
    "feedback",
    "annotations",
    "claude",
    "github",
    "vercel",
    "agent"
  ],
  "license": "MIT",
  "author": "Christian Giordano <christian@nuthinking.com> (https://nuthinking.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuthinking/site-edit.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./templates/*": "./templates/*"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "check": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "next": ">=13.4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "marked": "^18.0.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.7"
  }
}
